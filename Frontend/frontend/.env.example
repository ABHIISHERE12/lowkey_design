# Local development (used by `npm run dev`)
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# Production (Vercel)
# Do NOT hardcode the Render URL in React source files.
# Add this in Vercel → Project → Settings → Environment Variables
# (Production), then Redeploy:
#
#   VITE_API_URL=https://lowkey-design.onrender.com/api
#
# Vite bakes VITE_* values in at build time. Changing the variable later
# without redeploying will not update the live frontend.
# ---------------------------------------------------------------------------
